{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "strict":  true,
                            "skipLibCheck":  true,
                            "jsx":  "preserve",
                            "jsxImportSource":  "vue",
                            "resolveJsonModule":  true,
                            "esModuleInterop":  true,
                            "allowSyntheticDefaultImports":  true,
                            "lib":  [
                                        "ES2022",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "types":  [
                                          "vite/client"
                                      ],
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "src/*"
                                                  ]
                                      },
                            "noEmit":  true
                        },
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.vue"
                ]
}